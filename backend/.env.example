# Set these on your backend host. Never commit real values.
# Use the JDBC form of your Neon or Supabase connection string.
DATABASE_URL=jdbc:postgresql://YOUR_HOST/YOUR_DB?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Your Vercel site. Comma-separate several; patterns like https://*.vercel.app also work.
CORS_ALLOWED_ORIGINS=https://YOUR_SITE.vercel.app

# Set to true to create demo accounts on an empty database.
SEED_DEMO_DATA=false
DEMO_PASSWORD=
